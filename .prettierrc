{
  "plugins": ["prettier-plugin-astro"],
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "tabWidth": 4,
  "trailingComma": "none",
  "printWidth": 80,
  "proseWrap": "always",
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": "*.ts?(x)",
      "options": {
        "parser": "babel-ts"
      }
    }
  ]
}