{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "url": ["/", "/writing/", "/writing/hello-world/"],
            "numberOfRuns": 3
        },
        "assert": {
            "assertions": {
                "categories:performance": ["warn", { "minScore": 0.95 }],
                "resource-summary:script:size": [
                    "error",
                    { "maxNumericValue": 40960 }
                ]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": "./.lighthouseci"
        }
    }
}
