---
import Popover from "./Popover.astro";

interface Item {
  title: string;
  by?: string;
  href: string;
}
interface Section {
  heading: string;
  body?: string;
  bullets?: string[];
  linkText?: string;
  linkHref?: string;
  afterLink?: string;
  note?: string;
  after?: string;
  items?: Item[];
}
interface Props {
  sections: Section[];
  compact?: boolean;
}
const { sections, compact = false } = Astro.props;

// Minimal inline-code support (`word`) for bullet text — escape first so the
// data itself can't inject markup, then swap in <code> for backticked spans.
function mdInline(text: string): string {
  const escaped = text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return escaped.replace(/`([^`]+)`/g, "<code>$1</code>");
}
---

<div class:list={["sections", { compact }]}>
  {
    sections.map((s) => (
      <section class="section">
        <h3 class="mono heading">{s.heading}</h3>
        {s.body && <p class="body">{s.body}</p>}
        {s.bullets && (
          <ul class="bullets">
            {s.bullets.map((b) => (
              <li class="body" set:html={mdInline(b)} />
            ))}
          </ul>
        )}
        {s.linkText && (
          <p class="body">
            <a href={s.linkHref} target="_blank" rel="noopener" class="inline-link">
              {s.linkText}
            </a>
            {s.afterLink}
            {s.note && (
              <Popover>
                <span class="note-mark">*</span>
                <Fragment slot="panel">{s.note}</Fragment>
              </Popover>
            )}
            {s.after}
          </p>
        )}
        {s.items && (
          <ul class="items">
            {s.items.map((it) => (
              <li>
                <a href={it.href} target="_blank" rel="noopener" class="inline-link">
                  {it.title}
                </a>
                <span class="by">{it.by}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .sections {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .sections.compact {
    gap: 20px;
  }
  .section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .compact .section {
    gap: 6px;
  }
  .heading {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .compact .heading {
    font-size: 11px;
    color: var(--faint);
  }
  .body {
    margin: 0;
    font-size: 18px;
    line-height: 1.62;
    max-width: 33em;
  }
  .compact .body {
    font-size: 17px;
    line-height: 1.6;
  }
  .body :global(code) {
    background: var(--code-bg);
    padding: 2px 5px;
    border-radius: 3px;
    font-size: 0.85em;
    font-family: "IBM Plex Mono", monospace;
  }
  .bullets {
    margin: 0;
    padding-left: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .compact .bullets {
    gap: 5px;
  }
  .bullets .body {
    max-width: none;
  }
  .inline-link {
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .inline-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .note-mark {
    color: var(--accent);
    cursor: help;
  }
  .by {
    color: var(--muted);
  }
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .items li {
    font-size: 18px;
    line-height: 1.5;
  }
  .compact .items {
    gap: 6px;
  }
  .compact .items li {
    font-size: 17px;
    line-height: 1.5;
  }
</style>
