---
interface Props {
    src: string;
    alt: string;
    caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class='figure'>
    <img src={src} alt={alt} loading='lazy' />
    {caption && <figcaption class='mono'>{caption}</figcaption>}
</figure>

<style>
    .figure {
        margin: 12px 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    figcaption {
        font-size: 11px;
        line-height: 1.6;
        color: var(--faint);
    }
</style>
