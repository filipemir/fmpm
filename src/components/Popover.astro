---
// Pure-CSS hover popover: the invisible bridge keeps the panel open while
// the pointer travels the gap between trigger and panel, since :hover stays
// true for as long as the pointer is over the wrapper or any descendant.
---

<span class='popover'>
    <slot />
    <span class='bridge' aria-hidden='true'></span>
    <span class='panel mono' role='tooltip'><slot name='panel' /></span>
</span>

<style>
    .popover {
        position: relative;
        display: inline-block;
    }

    .bridge {
        position: absolute;
        left: calc(var(--space-88) * -1);
        right: calc(var(--space-88) * -1);
        top: 100%;
        height: var(--height-popover-arrow);
    }

    .panel {
        position: absolute;
        left: 50%;
        top: calc(100% + var(--space-10));
        z-index: 30;
        width: max-content;
        min-width: var(--width-popover-min);
        max-width: var(--width-popover-max);
        padding: var(--space-12) var(--space-14);
        background: var(--bg);
        border: 1px solid var(--ink);
        font-size: var(--font-12);
        line-height: 1.55;
        color: var(--muted);
        text-align: left;
        opacity: 0;
        transform: translateX(-50%) translateY(-4px);
        pointer-events: none;
        transition:
            opacity 160ms ease,
            transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .popover:hover .panel {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
    }

    .panel :global(a) {
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }
    .panel :global(a:hover) {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }
</style>
