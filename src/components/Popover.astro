---
// Pure-CSS hover popover: the invisible bridge keeps the panel open while
// the pointer travels the gap between trigger and panel, since :hover stays
// true for as long as the pointer is over the wrapper or any descendant.
---

<span class='popover'>
    <slot />
    <span class='bridge' aria-hidden='true'></span>
    <span class='panel mono' role='tooltip'><slot name='panel' /></span>
</span>

<style>
    .popover {
        position: relative;
        display: inline-block;
    }

    .bridge {
        position: absolute;
        left: -80px;
        right: -80px;
        top: 100%;
        height: 12px;
    }

    .panel {
        position: absolute;
        left: 50%;
        top: calc(100% + 10px);
        z-index: 30;
        width: 280px;
        margin-left: -140px;
        padding: 12px 14px;
        background: var(--bg);
        border: 1px solid var(--ink);
        font-size: 12px;
        line-height: 1.55;
        color: var(--muted);
        text-align: left;
        opacity: 0;
        transform: translateY(-4px);
        pointer-events: none;
        transition:
            opacity 160ms ease,
            transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .popover:hover .panel {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .panel :global(a) {
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }
    .panel :global(a:hover) {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }
</style>
