---
import Popover from '../Popover.astro';

interface Props {
    compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['now-entry', { compact }]}>
    <section class='now-block'>
        <h3 class='mono now-heading'>👨🏻‍💻 On-hours</h3>
        <p class='now-body'>Ramping up at my new role</p>
        <p class='now-body'>
            Learning <code>golang</code>.
        </p>
        <p class='now-body'>Restarting a monthly writing habit.</p>
    </section>

    <section class='now-block'>
        <h3 class='mono now-heading'>🏡 Off-hours</h3>
        <p class='now-body'>
            <a
                href='https://en.wikipedia.org/wiki/Sheet_mulching'
                target='_blank'
                rel='noopener'
                class='now-link'>Sheet mulching</a
            > a hill of goldenrod into a hill of clover.
            <Popover>
                <span class='now-note-mark'>*</span>
                <Fragment slot='panel'>
                    Who knew covering a small hill with cardboard and leaves
                    would take weeks.
                </Fragment>
            </Popover>
        </p>
        <p class='now-body'>
            Sneaking out as often as I can for Fall climbing.
        </p>
    </section>

    <section class='now-block'>
        <h3 class='mono now-heading'>📚 Reading</h3>
        <ul class='now-items'>
            <li>
                <a
                    href='https://www.oreilly.com/library/view/learning-go-2nd/9781098139285/'
                    target='_blank'
                    rel='noopener'
                    class='now-link'>Learning Go</a
                >
                <span class='now-by'> by Jon Bodner</span>
            </li>
            <li>
                <a
                    href='https://bookshop.org/p/books/the-inimitable-jeeves-deluxe-edition-p-g-wodehouse/c622b27ce995d8af?ean=9781782279709&bkshp-astro=t'
                    target='_blank'
                    rel='noopener'
                    class='now-link'>The Inimitable Jeeves</a
                >
                <span class='now-by'> by P.G Woodehouse</span>
            </li>
            <li>
                <a
                    href='https://bookshop.org/p/books/streets-of-laredo-a-novel-larry-mcmurtry/e4c71af67171e3cf'
                    target='_blank'
                    rel='noopener'
                    class='now-link'>Streets of Laredo</a
                >
                <span class='now-by'> by Larry McMurtry</span>
            </li>
        </ul>
    </section>

    <section class='now-block'>
        <h3 class='mono now-heading'>🎧 On rotation</h3>
        <ul class='now-items'>
            <li>
                <a
                    href='https://www.youtube.com/watch?v=tbZHguOCi3Q'
                    target='_blank'
                    rel='noopener'
                    class='now-link'>Wildflowers</a
                >
                <span class='now-by'> by Dolly</span>
            </li>
            <li>
                <a
                    href='https://www.youtube.com/watch?v=hK5FuEMdVho'
                    target='_blank'
                    rel='noopener'
                    class='now-link'>Baby I'll Change</a
                >
                <span class='now-by'> by Fiddlehead</span>
            </li>
            <li>
                <a
                    href='https://sophomorelounge.bandcamp.com/track/new-threats-from-the-soul'
                    target='_blank'
                    rel='noopener'
                    class='now-link'>New Threats from the Soul</a
                >
                <span class='now-by'> by Ryan Davis</span>
            </li>
            <li>
                <a
                    href='https://brokerecord.bandcamp.com/album/e-t-d-s-a-mixtape-by-idk'
                    target='_blank'
                    rel='noopener'
                    class='now-link'>e.t.d.s</a
                >
                <span class='now-by'> by IDK</span>
            </li>
        </ul>
    </section>
</div>
