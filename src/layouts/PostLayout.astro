---
import Layout from './Layout.astro';
import LightboxOverlay from '../components/LightboxOverlay.astro';
import { formatMonthYear } from '../lib/format';
import '../styles/prose.css';

interface Props {
    title: string;
    date: Date;
    minutes?: number;
    blurb?: string;
}
const { title, date, minutes, blurb } = Astro.props;
const meta = minutes
    ? `${formatMonthYear(date)} · ${minutes} min`
    : formatMonthYear(date);
---

<Layout
    title={`${title} — Filipe Miranda`}
    description={blurb}
    active='writing'
>
    <main class='post'>
        <div class='head'>
            <h1>{title}</h1>
            <span class='mono meta'>{meta}</span>
        </div>

        <article class='prose'>
            <slot />
        </article>

        <div class='foot mono'>
            <a href='/writing' class='back'>← All writing</a>
        </div>
    </main>

    <LightboxOverlay />
</Layout>

<script src='../scripts/footnotes.js'></script>

<style>
    .post {
        display: flex;
        flex-direction: column;
        gap: var(--space-32);
    }
    .head {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
    }
    h1 {
        margin: 0;
        font-size: var(--font-32);
        font-weight: 400;
        line-height: 1.22;
        letter-spacing: -0.02em;
        max-width: 26em;
    }
    .meta {
        font-size: var(--font-12);
        color: var(--faint);
    }
    .foot {
        display: flex;
        flex-direction: column;
        gap: var(--space-10);
        margin-top: var(--space-10);
        padding-top: var(--space-24);
        border-top: 1px solid var(--line);
        font-size: var(--font-12);
        line-height: 1.7;
        color: var(--muted);
    }
    .back {
        margin-top: var(--space-8);
        text-decoration: none;
        color: var(--muted);
        border-bottom: 1px solid var(--rule);
        width: fit-content;
    }
    .back:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }
</style>
