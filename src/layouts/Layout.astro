---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
    active?: 'writing' | 'reading' | 'now' | null;
}

const {
    title,
    description = 'Filipe Miranda — staff engineer at Atticus, writing about software and the rest of it.',
    active = null
} = Astro.props;
---

<!doctype html>
<html lang='en'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <title>{title}</title>
        <meta name='description' content={description} />
        <link rel='canonical' href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel='icon' href='/favicon/favicon.ico' sizes='any' />
        <link rel='apple-touch-icon' href='/favicon/apple-touch-icon.png' />
        <link rel='manifest' href='/favicon/site.webmanifest' />

        <meta property='og:type' content='website' />
        <meta
            property='og:url'
            content={new URL(Astro.url.pathname, Astro.site)}
        />
        <meta property='og:title' content={title} />
        <meta property='og:description' content={description} />
        <meta property='og:image' content={new URL('/share.png', Astro.site)} />
        <meta name='twitter:card' content='summary_large_image' />
        <meta name='twitter:title' content={title} />
        <meta name='twitter:description' content={description} />
        <meta
            name='twitter:image'
            content={new URL('/share.png', Astro.site)}
        />

        <link rel='preconnect' href='https://fonts.googleapis.com' />
        <link
            rel='preconnect'
            href='https://fonts.gstatic.com'
            crossorigin=''
        />
        <link
            href='https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap'
            rel='stylesheet'
        />
        <ClientRouter />
    </head>
    <body>
        <div class='page'>
            <div class='container'>
                <Header active={active} />
                <main>
                    <slot />
                </main>
                <Footer />
            </div>
        </div>
    </body>
</html>

<style>
    .page {
        min-height: 100vh;
    }
    .container {
        max-width: 640px;
        margin: 0 auto;
        padding: 88px 28px 140px;
        display: flex;
        flex-direction: column;
        gap: 56px;
    }
</style>
