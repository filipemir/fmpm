---
import Layout from '@/layouts/Layout.astro';
import books from '@/data/books.json';

type Book = {
    title: string;
    author: string;
    month: number;
    year: number;
    fav?: boolean;
};

const MONTH_ABBR = [
    'Jan',
    'Feb',
    'Mar',
    'Apr',
    'May',
    'Jun',
    'Jul',
    'Aug',
    'Sep',
    'Oct',
    'Nov',
    'Dec'
];

// books.json is stored newest-first. A book is a re-read if the same
// title+author pair already appears later in the array (i.e. earlier in
// real reading order) — computed here instead of hand-authored per entry,
// so it can't silently drift out of date the way a manual flag did.
const rereads = new WeakSet<Book>();
{
    const seen = new Set<string>();
    for (let i = (books as Book[]).length - 1; i >= 0; i--) {
        const b = (books as Book[])[i];
        const key = `${b.title}|${b.author}`;
        if (seen.has(key)) {
            rereads.add(b);
        } else {
            seen.add(key);
        }
    }
}

const byYear: { year: number; books: Book[] }[] = [];
for (const b of books as Book[]) {
    let g = byYear[byYear.length - 1];
    if (!g || g.year !== b.year) {
        g = { year: b.year, books: [] };
        byYear.push(g);
    }
    g.books.push(b);
}
const favorites = (books as Book[]).filter((b) => b.fav);
---

<Layout title='Books — Filipe Miranda' active='reading'>
    <main class='reading'>
        <div class='head'>
            <h1>Books</h1>
            <button
                type='button'
                data-favs-toggle
                class='favs-btn'
                aria-pressed='false'
            >
                <span class='star'>★</span>
                <span class='favs-label' data-favs-label>Favourites only</span>
            </button>
        </div>

        <div class='years' data-view='all'>
            {
                byYear.map((yr) => (
                    <section class='year-group'>
                        <div class='year-head'>
                            <h2 class='mono'>{yr.year}</h2>
                            <span class='rule' />
                        </div>
                        <ul class='book-list'>
                            {yr.books.map((book) => (
                                <li class='book-row'>
                                    <span class='book-title'>
                                        {book.title}
                                        {book.fav && (
                                            <span class='star-suffix'> ★</span>
                                        )}
                                        {rereads.has(book) && (
                                            <span class='pill'>Re-read</span>
                                        )}
                                    </span>
                                    <span class='mono book-when'>
                                        {MONTH_ABBR[book.month - 1]}
                                    </span>
                                    <span class='book-meta'>{book.author}</span>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>

        <ul class='book-list favs-view' data-view='favs' hidden>
            {
                favorites.map((book) => (
                    <li class='book-row'>
                        <span class='book-title'>
                            {book.title}
                            {rereads.has(book) && (
                                <span class='pill'>Re-read</span>
                            )}
                        </span>
                        <span class='mono book-when'>
                            {MONTH_ABBR[book.month - 1]} {book.year}
                        </span>
                        <span class='book-meta'>{book.author}</span>
                    </li>
                ))
            }
        </ul>

        <p class='mono legend'>★ favourite</p>
    </main>

    <script src='../../scripts/books.js'></script>
</Layout>

<style>
    .reading {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }
    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px 20px;
    }
    h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 400;
        letter-spacing: -0.02em;
    }

    .favs-btn {
        appearance: none;
        background: none;
        border: none;
        margin: 0;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: baseline;
        gap: 7px;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--faint);
        transition: color 120ms ease;
    }
    .favs-btn:hover {
        color: var(--accent);
    }
    .favs-btn .star {
        font-size: 11px;
    }
    .favs-btn .favs-label {
        border-bottom: 1px solid var(--rule);
    }
    .favs-btn[aria-pressed='true'] {
        color: var(--accent);
    }
    .favs-btn[aria-pressed='true'] .favs-label {
        border-bottom-color: var(--accent);
    }

    .years {
        display: flex;
        flex-direction: column;
        gap: 40px;
    }
    .years[hidden],
    .favs-view[hidden] {
        display: none;
    }

    .year-group {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }
    .year-head {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .year-head h2 {
        margin: 0;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.1em;
        color: var(--faint);
    }
    .year-head .rule {
        flex: 1;
        height: 1px;
        background: var(--line);
    }

    .book-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .book-row {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        column-gap: 20px;
        row-gap: 4px;
    }
    .book-title {
        font-size: 18px;
        line-height: 1.45;
        text-wrap: pretty;
    }
    .star-suffix {
        font-size: 20px;
        color: var(--faint);
        vertical-align: 2px;
    }
    .pill {
        display: inline-block;
        margin-left: 8px;
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--code-bg);
        color: var(--faint);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        vertical-align: 2px;
    }
    .book-when {
        font-size: 12px;
        color: var(--faint);
        white-space: nowrap;
    }
    .book-meta {
        grid-column: 1 / -1;
        font-size: 16px;
        line-height: 1.5;
        color: var(--muted);
        text-wrap: pretty;
    }

    .favs-view {
        gap: 20px;
    }

    .legend {
        margin: 8px 0 0;
        font-size: 11px;
        line-height: 1.7;
        color: var(--faint);
    }
</style>
