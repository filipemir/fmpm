---
import Layout from '@/layouts/Layout.astro';
import { getSortedPosts } from '@/lib/posts';
import { formatMonthYear } from '@/lib/format';

const pinnedPosts = (await getSortedPosts()).filter((p) => p.data.pinned);
---

<Layout title='Pinned Notes — Filipe Miranda'>
    <main class='notes-page'>
        <div class='head'>
            <h1>📌 Pinned Notes</h1>
            <p class='intro'>
                Pieces I've pinned because I still lean on them. These get
                edited as my thinking changes, so treat the dates as
                last-touched rather than published.
            </p>
        </div>
        {
            pinnedPosts.length > 0 ? (
                <ul class='notes'>
                    {pinnedPosts.map((post) => (
                        <li class='note-row'>
                            <div class='note-head'>
                                <a
                                    href={`/writing/${post.id}`}
                                    class='note-title'
                                >
                                    {post.data.title}
                                </a>
                                <span class='mono note-date'>
                                    {formatMonthYear(post.data.date)}
                                </span>
                            </div>
                            <span class='note-blurb'>{post.data.blurb}</span>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class='tk'>TK — nothing pinned yet.</p>
            )
        }
    </main>
</Layout>

<style>
    .notes-page {
        display: flex;
        flex-direction: column;
        gap: 40px;
    }
    .head {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    h1 {
        margin: 0;
        font-size: var(--fs-title);
        font-weight: var(--fw-normal);
        line-height: var(--lh-title);
        letter-spacing: var(--tr-title);
    }
    .intro {
        margin: 0;
        font-size: var(--fs-body);
        line-height: var(--lh-body);
        color: var(--muted);
        max-width: 33em;
    }
    .notes {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 30px;
    }
    .note-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .note-head {
        display: flex;
        align-items: baseline;
        gap: 14px;
    }
    .note-title {
        font-size: var(--fs-body);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }
    .note-title:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }
    .note-date {
        font-size: var(--fs-micro);
        color: var(--faint);
        white-space: nowrap;
    }
    .note-blurb {
        font-size: var(--fs-small);
        line-height: var(--lh-snug);
        color: var(--muted);
        max-width: 33em;
    }
    .tk {
        margin: 0;
        font-size: var(--fs-small);
        color: var(--faint);
    }
</style>
