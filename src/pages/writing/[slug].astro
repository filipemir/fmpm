---
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { getAllPosts } from '@/lib/posts';

export async function getStaticPaths() {
    // Drafts included on purpose: a draft's page still builds and its URL
    // stays reachable directly, it just doesn't appear in any listing (see
    // getSortedPosts/getListedPosts, used everywhere posts are surfaced as
    // a list) or the sitemap (filtered in astro.config.mjs).
    const posts = await getAllPosts();
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post }
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
    title={post.data.title}
    date={post.data.date}
    minutes={post.data.minutes}
    blurb={post.data.blurb}
>
    <Content />
</PostLayout>
