---
import Layout from '@/layouts/Layout.astro';
import { getListedPosts } from '@/lib/posts';
import { formatMonthYear } from '@/lib/format';

const posts = await getListedPosts();
---

<Layout title='Posts by Filipe Miranda' active='writing'>
    <main class='writing'>
        <div class='head'>
            <h1>Posts</h1>
            <p class='intro'>All words artisanally written like it's 2022.</p>
        </div>

        {
            posts.length > 0 ? (
                <ul class='posts'>
                    {posts.map((post) => (
                        <li class='post-row'>
                            <div class='post-head'>
                                <a
                                    href={`/writing/${post.id}`}
                                    class='post-title'
                                >
                                    {post.data.title}
                                </a>
                                <span class='mono post-date'>
                                    {formatMonthYear(post.data.date)}
                                </span>
                            </div>
                            <span class='post-blurb'>{post.data.blurb}</span>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class='tk'>TK — first post coming soon.</p>
            )
        }
    </main>
</Layout>

<style>
    .writing {
        display: flex;
        flex-direction: column;
        gap: var(--space-32);
    }
    .head {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
    }
    h1 {
        margin: 0;
        font-size: var(--font-32);
        font-weight: 400;
        letter-spacing: -0.02em;
    }
    .intro {
        margin: 0;
        font-size: var(--font-18);
        line-height: 1.6;
        color: var(--muted);
    }
    .posts {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-32);
    }
    .post-row {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }
    .post-head {
        display: flex;
        align-items: baseline;
        gap: var(--space-14);
    }
    .post-title {
        font-size: var(--font-20);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }
    .post-title:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }
    .post-date {
        font-size: var(--font-11);
        color: var(--faint);
        white-space: nowrap;
    }
    .post-blurb {
        font-size: var(--font-16);
        line-height: 1.58;
        color: var(--muted);
        max-width: 33em; /* allow-hardcoded-size: font-relative measure */
    }
    .tk {
        margin: 0;
        font-size: var(--font-16);
        color: var(--faint);
    }
</style>
