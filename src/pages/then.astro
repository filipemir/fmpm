---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NowEntry from '../components/NowEntry.astro';
import { formatFullMonthYear } from '../lib/format';

const entries = (await getCollection('now')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const pastEntries = entries.slice(1);
---

<Layout title='THEN() — Filipe Miranda'>
    <main class='archive'>
        <div class='head'>
            <h1 class='mono'>THEN()</h1>
            <p class='intro'>
                Old <a href='/now' class='mono now-link'>NOW()</a> entries.
            </p>
        </div>
        {
            pastEntries.length > 0 ? (
                <div class='entries'>
                    {pastEntries.map((entry) => (
                        <article class='entry'>
                            <h2 class='mono entry-date'>
                                {formatFullMonthYear(entry.data.date)}
                            </h2>
                            <NowEntry entry={entry} compact />
                        </article>
                    ))}
                </div>
            ) : (
                <p class='tk'>TK — nothing archived yet.</p>
            )
        }
    </main>
</Layout>

<style>
    .archive {
        display: flex;
        flex-direction: column;
        gap: 44px;
    }
    .head {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    h1 {
        margin: 0;
        font-size: 27px;
        font-weight: 400;
        letter-spacing: -0.02em;
    }
    .intro {
        margin: 0;
        font-size: 18px;
        line-height: 1.6;
        color: var(--muted);
    }
    .now-link {
        font-size: 16px;
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }
    .now-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }
    .entries {
        display: flex;
        flex-direction: column;
        gap: 44px;
    }
    .entry {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding-top: 22px;
        border-top: 1px solid var(--line);
    }
    .entry-date {
        margin: 0;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
    }
    .tk {
        margin: 0;
        font-size: 16px;
        color: var(--faint);
    }
</style>
