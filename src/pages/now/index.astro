---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import NowEntry from '@/components/NowEntry.astro';
import { formatFullMonthYear } from '@/lib/format';

const entries = (await getCollection('now')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const current = entries[0];
---

<Layout title='NOW() — Filipe Miranda' active='now'>
    <main class='now'>
        <NowEntry entry={current} />
        <p class='mono updated'>
            Updated {formatFullMonthYear(current.data.date)}. See archive{' '}
            <a href='/then'>here</a>.
        </p>
    </main>
</Layout>

<style>
    .now {
        display: flex;
        flex-direction: column;
        gap: var(--space-40);
    }
    .updated {
        margin: var(--space-16) 0 0;
        padding-top: var(--space-24);
        border-top: 1px solid var(--line);
        font-size: var(--font-12);
        line-height: 1.7;
        color: var(--faint);
    }
    .updated a {
        color: var(--muted);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }
    .updated a:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }
</style>
